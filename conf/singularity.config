// Singularity profile. Same image and mounts as conf/apptainer.config.
singularity.enabled = true
singularity.autoMounts = true
process.container = 'docker://ghcr.io/aglucaci/triarchy:1.0.0'
singularity.runOptions = "-B ${projectDir}:${projectDir}:ro" +
    (params.reference_root ? " -B ${params.reference_root}:${params.reference_root}:ro" : '')
