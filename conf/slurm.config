// Built-in Slurm resource profile. Site-specific partitions, accounts, and
// modules should be supplied in a local config file kept outside the release.
process.executor = 'slurm'
executor.queueSize = 50

process {
    withLabel: low {
        cpus = 1
        memory = 2.GB
        time = 1.h
    }

    withLabel: medium {
        cpus = 4
        memory = 16.GB
        time = 8.h
    }

    withLabel: high {
        cpus = 12
        memory = 96.GB
        time = 48.h
    }

    // Full PlusPFP is memory-mapped; limit concurrent database scans to avoid
    // saturating shared storage with identical large random-read workloads.
    withName: WGS_TAXONOMY {
        maxForks = 2
    }
}
