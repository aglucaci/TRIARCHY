// TRIARCHY 30-minute showcase configuration.
//
// Recommended local command:
//   ./run_triarchy.sh --demo
//
// Direct Nextflow command:
//   nextflow run main.nf -stub-run -profile demo -c conf/demo_30min.config

params.samples = "${projectDir}/benchmarks/TRI-31/metadata/samples.tsv"
params.controls = "${projectDir}/benchmarks/TRI-31/metadata/control_relationships.tsv"
params.outdir = 'results/showcase_30min'

params.cutadapt_16s_forward = 'CCTACGGGNGGCWGCAG'
params.cutadapt_16s_reverse = 'GACTACHVGGGTATCTAATCC'
params.cutadapt_its_forward = 'GTGAATCATCGAATCTTTGAA'
params.cutadapt_its_reverse = 'TCCTCCGCTTATTGATATGC'

process.executor = 'local'
executor.queueSize = 4

process {
    withLabel: low {
        cpus = 1
        memory = 1.GB
        time = 30.m
    }
    withLabel: medium {
        cpus = 2
        memory = 4.GB
        time = 2.h
    }
    withLabel: high {
        cpus = 4
        memory = 8.GB
        time = 4.h
    }
}
