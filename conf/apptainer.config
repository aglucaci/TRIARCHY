// Apptainer profile. Pulls the versioned TRIARCHY OCI image and converts it to
// SIF. Pin the image digest (image@sha256:...) for publication runs.
apptainer.enabled = true
apptainer.autoMounts = true
process.container = 'docker://ghcr.io/aglucaci/triarchy:1.0.0'

// Bind projectDir and the reference root at identical paths (read-only).
apptainer.runOptions = "-B ${projectDir}:${projectDir}:ro" +
    (params.reference_root ? " -B ${params.reference_root}:${params.reference_root}:ro" : '')
