// Docker profile. Runs every task in the versioned TRIARCHY image built from
// the repository Dockerfile. Pin the image digest (image@sha256:...) for
// publication runs.
docker.enabled = true
process.container = 'ghcr.io/aglucaci/triarchy:1.0.0'

// Task scripts call files under projectDir and open reference databases by
// absolute path, so both are mounted read-only at identical paths.
// `triarchy run` sets params.reference_root from references/.database-dir.
docker.runOptions = "-v ${projectDir}:${projectDir}:ro" +
    (params.reference_root ? " -v ${params.reference_root}:${params.reference_root}:ro" : '')
