flowchart TB
    INPUTS["Sample manifest<br/>Control relationships"] --> VALIDATE["Validate metadata"]
    VALIDATE --> SPLIT["Split manifests by assay"]
    INPUTS --> PROV["Run provenance"]

    SPLIT --> WMS_IN["WMS libraries"]
    SPLIT --> S16_IN["16S libraries"]
    SPLIT --> ITS_IN["ITS libraries"]

    subgraph WMS["Shotgun metagenomic branch"]
        WMS_IN --> WMS_QC["fastp quality control"]
        WMS_QC --> HOST["Bowtie2 host removal"]
        HOST --> KRAKEN["Kraken 2 + Bracken<br/>taxonomic profiling"]
        HOST --> HUMANN["HUMAnN<br/>functional profiling"]
    end

    subgraph S16["16S branch"]
        S16_IN --> S16_QC["cutadapt<br/>primer and quality trimming"]
        S16_QC --> S16_DADA["DADA2<br/>ASV inference and taxonomy"]
    end

    subgraph ITS["ITS branch"]
        ITS_IN --> ITS_QC["cutadapt<br/>primer and quality trimming"]
        ITS_QC --> ITSX["ITSxpress<br/>ITS-region extraction"]
        ITSX --> ITS_DADA["DADA2<br/>ASV inference and taxonomy"]
    end

    WMS_QC --> QC_SUM["Library QC summary"]
    HOST --> QC_SUM
    S16_QC --> QC_SUM
    ITS_QC --> QC_SUM

    KRAKEN --> CONTROLS["Linked-control annotation<br/>Taxa + functions"]
    HUMANN --> CONTROLS
    S16_DADA --> CONTROLS
    ITS_DADA --> CONTROLS
    INPUTS --> CONTROLS

    CONTROLS --> UNFILTERED["Unfiltered profiles"]
    CONTROLS --> ANNOTATED["Control-annotated profiles"]
    CONTROLS --> HIGH_CONF["High-confidence profiles"]
    CONTROLS --> SAMPLE_CONF["Sample confidence"]

    ANNOTATED --> HARMONIZE["Taxonomic harmonization<br/>Canonical shared ranks"]
    HARMONIZE --> EVIDENCE["Authenticity + cross-assay explanation"]
    HARMONIZE --> CONCORDANCE["Cross-assay concordance"]
    QC_SUM --> EVIDENCE
    POLICY["Assay performance<br/>Evidence policy"] --> EVIDENCE
    INPUTS --> EVIDENCE

    HIGH_CONF --> DIVERSITY["Assay-specific diversity<br/>Alpha + beta"]
    CONTROLS --> DIVERSITY

    EVIDENCE --> REPORT["Interactive TRIARCHY report"]
    CONCORDANCE --> REPORT
    DIVERSITY --> REPORT
    SAMPLE_CONF --> REPORT
    PROV --> REPORT

    REPORT --> OUTPUTS["Final outputs<br/>QC / profiles / evidence / diversity<br/>provenance / HTML report"]

    classDef input fill:#e8eef3,stroke:#18324a,color:#17222d
    classDef wms fill:#d8eaf6,stroke:#18324a,color:#17222d
    classDef s16 fill:#ddf1e5,stroke:#18324a,color:#17222d
    classDef its fill:#f3e5d2,stroke:#18324a,color:#17222d
    classDef integration fill:#e9e1f5,stroke:#18324a,color:#17222d
    classDef output fill:#d9ece9,stroke:#18324a,color:#17222d

    class INPUTS,VALIDATE,SPLIT,PROV,QC_SUM,POLICY input
    class WMS_IN,WMS_QC,HOST,KRAKEN,HUMANN wms
    class S16_IN,S16_QC,S16_DADA s16
    class ITS_IN,ITS_QC,ITSX,ITS_DADA its
    class CONTROLS,UNFILTERED,ANNOTATED,HIGH_CONF,SAMPLE_CONF,HARMONIZE,EVIDENCE,CONCORDANCE,DIVERSITY integration
    class REPORT,OUTPUTS output
