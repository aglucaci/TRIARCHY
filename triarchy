def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def parse_scalar(value: str) -> str | bool | int | float | None:
    value = value.strip().strip('"').strip("'")
    if value in {"", "null", "Null", "NULL", "~"}:
        return None
    if value in {"true", "True", "TRUE"}:
        return True
    if value in {"false", "False", "FALSE"}:
        return False
    try:
        return int(value)
    except ValueError:
        pass
    try:
        return float(value)
    except ValueError:
        return value


def parse_simple_yaml(path: Path) -> dict[str, Any]:
    """Parse the small YAML subset used by conf/databases.example.yml.

    This intentionally avoids a PyYAML dependency for the test/preflight path.
    Supported forms are nested mappings by two-space indentation and lists of
    mappings under a key, which is enough for the reference manifest.
    """
    root: dict[str, Any] = {}
    stack: list[tuple[int, dict[str, Any] | list[Any]]] = [(-1, root)]
    last_key: dict[int, str] = {}
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.split("#", 1)[0].rstrip()
        if not line.strip():
            continue
        indent = len(line) - len(line.lstrip(" "))
        text = line.strip()
        while stack and indent <= stack[-1][0]:
            stack.pop()
        parent = stack[-1][1]
        if text.startswith("- "):
            if not isinstance(parent, list):
                raise ValueError(f"YAML list item has no list parent: {raw_line}")
            item_text = text[2:]
            item: dict[str, Any] = {}
            parent.append(item)
            if item_text:
                key, sep, value = item_text.partition(":")
                if not sep:
                    raise ValueError(f"unsupported YAML list item: {raw_line}")
                item[key.strip()] = parse_scalar(value)
                last_key[indent + 2] = key.strip()
            stack.append((indent, item))
            continue
        key, sep, value = text.partition(":")
        if not sep:
            raise ValueError(f"unsupported YAML line: {raw_line}")
        key = key.strip()
        if value.strip():
            if not isinstance(parent, dict):
                raise ValueError(f"YAML scalar has non-mapping parent: {raw_line}")
            parent[key] = parse_scalar(value)
            last_key[indent] = key
            continue
        child: dict[str, Any] | list[Any]
        child = [] if key.endswith("s") or key in {"references", "databases"} else {}
        if not isinstance(parent, dict):
            raise ValueError(f"YAML mapping has non-mapping parent: {raw_line}")
        parent[key] = child
        last_key[indent] = key
        stack.append((indent, child))
    return root


def load_manifest(path: Path) -> dict[str, Any]:
    suffix = path.suffix.casefold()
    if suffix == ".json":
        return json.loads(path.read_text(encoding="utf-8"))
    if suffix in {".yml", ".yaml"}:
        return parse_simple_yaml(path)
    with path.open(encoding="utf-8", newline="") as handle:
        return {"references": list(csv.DictReader(handle, delimiter="\t"))}


def manifest_references(manifest: dict[str, Any]) -> list[dict[str, Any]]:
    refs = manifest.get("references", manifest.get("databases", []))
    if isinstance(refs, dict):
        return [dict({"id": key}, **value) for key, value in refs.items()]
    return [dict(item) for item in refs]


def resolve_reference_path(ref: dict[str, Any], destination: Path | None, manifest_dir: Path) -> Path | None:
    raw = ref.get("path") or ref.get("relative_path") or ref.get("prefix")
    if not raw:
        return None
    path = Path(str(raw)).expanduser()
    if path.is_absolute():
        return path
    if destination:
        return destination / path
    return manifest_dir / path


def check_databases(manifest_path: Path, destination: Path | None) -> dict[str, Any]:
    manifest = load_manifest(manifest_path)
    references = manifest_references(manifest)
    results = []
    ok = True
    for ref in references:
        ref_id = str(ref.get("id") or ref.get("name") or "unnamed")
        path = resolve_reference_path(ref, destination, manifest_path.parent)
        required = bool(ref.get("required", True))
        status = "missing_path"
        digest = ""
        if path is None:
            ok = ok and not required
        elif not path.exists():
            status = "missing"
            ok = ok and not required
        elif path.is_dir():
            files = [item for item in path.rglob("*") if item.is_file()]
            status = "present" if files else "empty"
            ok = ok and (status == "present" or not required)
        else:
            digest = sha256(path)
            expected = str(ref.get("sha256") or "").strip().casefold()
            status = "checksum_ok" if not expected or digest == expected else "checksum_mismatch"
            ok = ok and (status != "checksum_mismatch" or not required)
        results.append({
            "id": ref_id,
            "kind": ref.get("kind", ""),
            "version": ref.get("version", ""),
            "required": required,
            "path": str(path) if path else "",
            "sha256": digest,
            "status": status,
        })
    return {
        "manifest": str(manifest_path),
        "destination": str(destination) if destination else "",
        "checked_at": datetime.now(timezone.utc).isoformat(),
        "ok": ok,
        "references": results,
    }


def command_validate(args: argparse.Namespace) -> int:
    errors = []
    try:
        sample_count, control_count = validate(args.samples, args.controls)
    except (OSError, MetadataError) as error:
        errors.append(str(error))
        sample_count = control_count = 0

    if args.check_fastqs:
        try:
            rows = read_tsv(args.samples, set(), "sample manifest")
            base_dir = args.samples.parent
            for row in rows:
                for field in ("fastq_r1", "fastq_r2"):
                    value = row.get(field, "")
                    if not value:
                        continue
                    path = Path(value)
                    if not path.is_absolute():
                        path = base_dir / path
                    if not path.exists():
                        errors.append(f"missing FASTQ for {row.get('library_id', '')}: {path}")
        except OSError as error:
            errors.append(str(error))

    database_report = None
    if args.databases:
        try:
            database_report = check_databases(args.databases, args.database_destination)
            for ref in database_report["references"]:
                if ref["required"] and ref["status"] not in {"present", "checksum_ok"}:
                    errors.append(f"database {ref['id']} is {ref['status']}: {ref['path']}")
        except (OSError, ValueError, json.JSONDecodeError) as error:
            errors.append(f"database manifest error: {error}")

    report = {
        "ok": not errors,
        "sample_libraries": sample_count,
        "control_relationships": control_count,
        "fastq_check": bool(args.check_fastqs),
        "database_check": database_report,
        "errors": errors,
    }
    if args.report:
        args.report.parent.mkdir(parents=True, exist_ok=True)
        args.report.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
    if errors:
        for error in errors:
            print(f"ERROR: {error}", file=sys.stderr)
        return 2
    print(f"VALID: {sample_count} libraries; {control_count} control relationships.")
    if database_report:
        print(f"VALID: {len(database_report['references'])} database references checked.")
    return 0


def command_run(args: argparse.Namespace) -> int:
    preflight = argparse.Namespace(
        samples=args.samples,
        controls=args.controls,
        check_fastqs=True,
        databases=None,
        database_destination=None,
        report=None,
    )
    if command_validate(preflight):
        return 2

    version_file = ROOT / ".nextflow-version"
    main_script = ROOT / "main.nf"
    reference_config = ROOT / "conf" / "references.config"
    primer_config = ROOT / "conf" / "primers.config"
    local_nextflow = ROOT / ".tools" / "bin" / "nextflow"

    for required in (version_file, main_script, primer_config, reference_config):
        if not required.exists():
            print(f"ERROR: required production file is missing: {required}", file=sys.stderr)
            if required == reference_config:
                print("Run ./install.sh to install the full production references.", file=sys.stderr)
            return 2

    nextflow = str(local_nextflow) if local_nextflow.is_file() else shutil.which("nextflow")
    if not nextflow:
        print("ERROR: Nextflow is not installed; run ./install.sh first.", file=sys.stderr)
        return 2

    command = [
        nextflow,
        "run",
        str(main_script),
        "-profile",
        args.profile,
        "-c",
        str(reference_config),
    ]
    cohort_config = getattr(args, "cohort_config", None)
    if cohort_config:
        if not cohort_config.is_file():
            print(f"ERROR: cohort configuration is missing: {cohort_config}", file=sys.stderr)
            return 2
        command.extend(["-c", str(cohort_config.resolve())])
    site_config = getattr(args, "site_config", None)
    if site_config:
        if not site_config.is_file():
            print(f"ERROR: site configuration is missing: {site_config}", file=sys.stderr)
            return 2
        command.extend(["-c", str(site_config.resolve())])
    work_dir = getattr(args, "work_dir", None)
    if work_dir:
        command.extend(["-work-dir", str(work_dir.resolve())])
    command.extend([
        "--samples",
        str(args.samples.resolve()),
        "--controls",
        str(args.controls.resolve()),
        "--outdir",
        str(args.outdir),
    ])
    database_dir_file = ROOT / "references" / ".database-dir"
    if args.profile in CONTAINER_PROFILES and database_dir_file.is_file():
        reference_root = database_dir_file.read_text(encoding="utf-8").strip()
        if reference_root:
            command.extend(["--reference_root", reference_root])
    if args.resume:
        command.append("-resume")
    extra = list(args.nextflow_args or [])
    if extra and extra[0] == "--":
        extra.pop(0)
    command.extend(extra)

    env = os.environ.copy()
    env.setdefault("NXF_HOME", str(ROOT / ".nextflow"))
    env.setdefault("NXF_VER", version_file.read_text(encoding="utf-8").strip())
    print(f"TRIARCHY: starting production run with profile {args.profile}")
    completed = subprocess.run(command, cwd=ROOT, env=env, check=False)
    return completed.returncode


def command_database_check(args: argparse.Namespace) -> int:
    try:
        report = check_databases(args.manifest, args.destination)
    except (OSError, ValueError, json.JSONDecodeError) as error:
        print(f"ERROR: {error}", file=sys.stderr)
        return 2
    if args.report:
        args.report.parent.mkdir(parents=True, exist_ok=True)
        args.report.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(report, indent=2))
    return 0 if report["ok"] else 2


def command_database_install(args: argparse.Namespace) -> int:
    installer = ROOT / "scripts" / "install_databases.sh"
    if not installer.exists():
        print(f"ERROR: installer is missing: {installer}", file=sys.stderr)
        return 2
    if platform.system() == "Windows" and shutil.which("bash") is None:
        print(
            "ERROR: database installation requires bash on Windows; run from WSL2 or Git Bash.",
            file=sys.stderr,
        )
        return 2
    command = [
        "bash" if platform.system() == "Windows" else str(installer),
        str(installer) if platform.system() == "Windows" else "",
        "--database-dir", str(args.destination),
        "--env-prefix", sys.prefix,
    ]
    command = [item for item in command if item]
    if args.yes:
        command.append("--yes")
    if args.silva_archive:
        command.extend(["--silva-archive", str(args.silva_archive)])
    if args.kraken_archive:
        command.extend(["--kraken-archive", str(args.kraken_archive)])
    env = os.environ.copy()
    if args.download_attempts:
        env["TRIARCHY_DOWNLOAD_ATTEMPTS"] = str(args.download_attempts)
    completed = subprocess.run(command, cwd=ROOT, env=env, check=False)
    if completed.returncode:
        return completed.returncode
    if args.manifest:
        report = check_databases(args.manifest, args.destination)
        if args.report:
            args.report.parent.mkdir(parents=True, exist_ok=True)
            args.report.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
        return 0 if report["ok"] else 2
    return 0


def command_demo(args: argparse.Namespace) -> int:
    """Build and optionally run the real-reference production demo."""
    builder = ROOT / "scripts" / "build_production_demo.py"
    evaluator = ROOT / "scripts" / "evaluate_production_demo.py"
    data_dir = args.data_dir if args.data_dir.is_absolute() else ROOT / args.data_dir
    results_dir = args.outdir if args.outdir.is_absolute() else ROOT / args.outdir
    build_command = [
        sys.executable,
        str(builder),
        "--output", str(data_dir),
        "--seed", str(args.seed),
        "--scale", str(args.scale),
        "--error-rate", str(args.error_rate),
        "--timeout", str(args.timeout),
        "--retries", str(args.retries),
    ]
    if args.offline:
        build_command.append("--offline")
    if args.force:
        build_command.append("--force")
    completed = subprocess.run(build_command, cwd=ROOT, check=False)
    if completed.returncode or args.build_only:
        return completed.returncode

    metadata = data_dir / "metadata"
    nextflow_args = [
        "--taxonomy_crosswalk", str(metadata / "taxonomy_crosswalk.tsv"),
        "--assay_performance", str(metadata / "assay_performance.tsv"),
        "--kraken2_memory_mapping", "true",
    ]
    extra = list(args.nextflow_args or [])
    if extra and extra[0] == "--":
        extra.pop(0)
    nextflow_args.extend(extra)
    run_args = argparse.Namespace(
        samples=metadata / "samples.tsv",
        controls=metadata / "control_relationships.tsv",
        outdir=results_dir,
        profile=args.profile,
        resume=args.resume,
        site_config=args.site_config,
        work_dir=args.work_dir,
        nextflow_args=nextflow_args,
    )
    run_status = command_run(run_args)
    if run_status or args.skip_evaluation:
        return run_status
    evaluation = subprocess.run(
        [
            sys.executable,
            str(evaluator),
            "--results", str(results_dir),
            "--expectations", str(metadata / "expected_outcomes.tsv"),
        ],
        cwd=ROOT,
        check=False,
    )
    return evaluation.returncode


def command_real_world(args: argparse.Namespace) -> int:
    """Download, validate, and optionally run a public empirical cohort."""
    downloader = ROOT / "scripts" / "download_real_world_datasets.py"
    data_root = args.data_dir if args.data_dir.is_absolute() else ROOT / args.data_dir
    dataset_dir = data_root / args.dataset
    metadata = dataset_dir / "metadata"

    if not args.skip_download:
        download_command = [
            sys.executable,
            str(downloader),
            "--dataset", args.dataset,
            "--data-dir", str(data_root),
            "--download",
            "--timeout", str(args.timeout),
            "--retries", str(args.retries),
        ]
        if args.dataset == "TRI-REAL-01":
            download_command.extend(["--max-groups", str(args.max_groups)])
        else:
            for kit in args.extraction_kit or []:
                download_command.extend(["--extraction-kit", kit])
            download_command.extend(["--biomass-plate", args.biomass_plate])
            if args.max_biological_per_plate is not None:
                download_command.extend(
                    ["--max-biological-per-plate", str(args.max_biological_per_plate)]
                )
        if args.verify_md5:
            download_command.append("--verify-md5")
        if args.force:
            download_command.append("--force")

        download_env = os.environ.copy()
        if not download_env.get("SSL_CERT_FILE"):
            try:
                import certifi  # type: ignore[import-not-found]  # pylint: disable=import-outside-toplevel

                download_env["SSL_CERT_FILE"] = certifi.where()
            except ImportError:
                pass
        completed = subprocess.run(
            download_command, cwd=ROOT, env=download_env, check=False
        )
        if completed.returncode:
            return completed.returncode

    samples = metadata / "samples.tsv"
    controls = metadata / "control_relationships.tsv"
    preflight = argparse.Namespace(
        samples=samples,
        controls=controls,
        check_fastqs=True,
        databases=None,
        database_destination=None,
        report=None,
    )
    if command_validate(preflight):
        return 2

    control_rows = read_tsv(controls, set(), "control relationships")
    if not control_rows:
        print(
            "WARNING: this public cohort has no curated control relationships; "
            "contamination inference will not use its negative-control libraries.",
            file=sys.stderr,
        )
    if args.download_only:
        print(f"Dataset ready: {dataset_dir}")
        return 0

    cohort_config = None
    dataset_json = metadata / "dataset.json"
    if dataset_json.is_file():
        configured = json.loads(dataset_json.read_text(encoding="utf-8")).get("dataset", {})
        if configured.get("nextflow_config"):
            cohort_config = ROOT / configured["nextflow_config"]

    outdir = args.outdir or Path("results") / args.dataset
    results_dir = outdir if outdir.is_absolute() else ROOT / outdir
    run_args = argparse.Namespace(
        samples=samples,
        controls=controls,
        outdir=results_dir,
        cohort_config=cohort_config,
        profile=args.profile,
        resume=args.resume,
        site_config=args.site_config,
        work_dir=args.work_dir,
        nextflow_args=args.nextflow_args,
    )
    status = command_run(run_args)
    truth = dataset_dir / "truth" / "mock_truth.tsv"
    if status == 0 and truth.is_file():
        evaluator = ROOT / "scripts" / "evaluate_mock_truth.py"
        status = subprocess.run(
            [sys.executable, str(evaluator), "--results", str(results_dir),
             "--truth", str(truth), "--samples", str(samples)],
            cwd=ROOT, check=False,
        ).returncode
    return status


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="triarchy", description=__doc__)
    parser.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    sub = parser.add_subparsers(dest="command", required=True)

    run_parser = sub.add_parser("run", help="run a production TRIARCHY study")
    run_parser.add_argument("--samples", type=Path, required=True, help="production sample manifest")
    run_parser.add_argument("--controls", type=Path, required=True, help="production control relationships")
    run_parser.add_argument("--outdir", type=Path, default=Path("results/study"))
    run_parser.add_argument("--profile", choices=PRODUCTION_PROFILES, default="local")
    run_parser.add_argument("--resume", action="store_true")
    run_parser.add_argument(
        "--site-config", type=Path,
        help="site-specific Nextflow configuration, such as a SLURM account and partition",
    )
    run_parser.add_argument(
        "--work-dir", type=Path,
        help="shared Nextflow work directory for cluster execution",
    )
    run_parser.add_argument("nextflow_args", nargs=argparse.REMAINDER, help=argparse.SUPPRESS)
    run_parser.set_defaults(func=command_run)

    demo_parser = sub.add_parser(
        "demo",
        help="build and run the real-reference production demo",
    )
    demo_parser.add_argument(
        "--data-dir", type=Path, default=Path("data/production_demo"),
        help="generated study directory (default: data/production_demo)",
    )
    demo_parser.add_argument(
        "--outdir", type=Path, default=Path("results/production_demo"),
        help="production results directory (default: results/production_demo)",
    )
    demo_parser.add_argument(
        "--profile", choices=PRODUCTION_PROFILES, default="laptop",
        help="production execution profile (default: laptop)",
    )
    demo_parser.add_argument("--seed", type=int, default=20260827, help="read-generation seed")
    demo_parser.add_argument(
        "--scale", type=float, default=1.0,
        help="multiply every designed library size (default: 1.0)",
    )
    demo_parser.add_argument(
        "--error-rate", type=float, default=.001,
        help="per-base substitution rate (default: 0.001)",
    )
    demo_parser.add_argument("--timeout", type=int, default=60, help="download connect timeout in seconds")
    demo_parser.add_argument("--retries", type=int, default=3, help="download attempts per NCBI endpoint")
    demo_parser.add_argument("--offline", action="store_true", help="use only cached NCBI references")
    demo_parser.add_argument("--force", action="store_true", help="regenerate an existing fixture")
    demo_parser.add_argument("--build-only", action="store_true", help="generate and validate inputs without running Nextflow")
    demo_parser.add_argument("--skip-evaluation", action="store_true", help="run Nextflow without checking designed outcomes")
    demo_parser.add_argument(
        "--site-config", type=Path,
        help="site-specific Nextflow configuration, such as a SLURM account and partition",
    )
    demo_parser.add_argument(
        "--work-dir", type=Path,
        help="shared Nextflow work directory for cluster execution",
    )
    demo_parser.add_argument(
        "--resume", action=argparse.BooleanOptionalAction, default=True,
        help="resume cached Nextflow tasks (default: enabled)",
    )
    demo_parser.add_argument("nextflow_args", nargs=argparse.REMAINDER, help=argparse.SUPPRESS)
    demo_parser.set_defaults(func=command_demo)

    real_parser = sub.add_parser(
        "real-world",
        help="download and run a public empirical TRIARCHY cohort",
    )
    real_parser.add_argument(
        "--dataset", choices=("TRI-REAL-05", "TRI-REAL-01"), default="TRI-REAL-05",
        help=(
            "public cohort: TRI-REAL-05 = whole Shaffer extraction plates with linked "
            "blanks and ZymoBIOMICS truth (default); TRI-REAL-01 = small 4-group subset"
        ),
    )
    real_parser.add_argument(
        "--data-dir", type=Path, default=Path("data/real_world"),
        help="dataset root (default: data/real_world)",
    )
    real_parser.add_argument(
        "--outdir", type=Path,
        help="production results directory (default: results/<dataset>)",
    )
    real_parser.add_argument(
        "--max-groups", type=int, default=4,
        help="TRI-REAL-01 only: maximum selected sample/control groups (default: 4)",
    )
    real_parser.add_argument(
        "--extraction-kit", action="append",
        help=(
            "TRI-REAL-05 only: Qiita extraction_kit_round to include, repeatable "
            "(default: 'PowerSoil r1'; round-1 kits: 'PowerSoil r1', 'PowerSoil Pro', "
            "'MagMax Beta', 'Norgen', 'Zymo MagBead', 'Homebrew')"
        ),
    )
    real_parser.add_argument(
        "--biomass-plate", choices=("high", "low", "both"), default="both",
        help="TRI-REAL-05 only: extraction plates to include (default: both)",
    )
    real_parser.add_argument(
        "--max-biological-per-plate", type=int,
        help="TRI-REAL-05 only: cap non-mock biological samples per plate (default: all)",
    )
    real_parser.add_argument(
        "--profile", choices=PRODUCTION_PROFILES, default="slurm",
        help="production execution profile (default: slurm)",
    )
    real_parser.add_argument("--timeout", type=int, default=120)
    real_parser.add_argument("--retries", type=int, default=3)
    real_parser.add_argument(
        "--verify-md5", action=argparse.BooleanOptionalAction, default=True,
        help="verify ENA checksums (default: enabled)",
    )
    real_parser.add_argument("--force", action="store_true", help="replace downloaded FASTQs")
    real_parser.add_argument(
        "--skip-download", action="store_true",
        help="use an already downloaded cohort without contacting ENA",
    )
    real_parser.add_argument(
        "--download-only", action="store_true",
        help="download and validate inputs without starting Nextflow",
    )
    real_parser.add_argument(
        "--site-config", type=Path,
        help="site-specific Nextflow configuration, such as a SLURM account and partition",
    )
    real_parser.add_argument(
        "--work-dir", type=Path,
        help="shared Nextflow work directory for cluster execution",
    )
    real_parser.add_argument(
        "--resume", action=argparse.BooleanOptionalAction, default=True,
        help="resume cached Nextflow tasks (default: enabled)",
    )
    real_parser.add_argument("nextflow_args", nargs=argparse.REMAINDER, help=argparse.SUPPRESS)
    real_parser.set_defaults(func=command_real_world)

    validate_parser = sub.add_parser("validate", help="preflight metadata, FASTQs, and optional databases")
    validate_parser.add_argument("--input", "--samples", dest="samples", type=Path, required=True)
    validate_parser.add_argument("--paired-controls", "--controls", dest="controls", type=Path, required=True)
    validate_parser.add_argument("--databases", type=Path)
    validate_parser.add_argument("--database-destination", type=Path)
    validate_parser.add_argument("--skip-fastq-check", dest="check_fastqs", action="store_false")
    validate_parser.add_argument("--report", type=Path)
    validate_parser.set_defaults(check_fastqs=True, func=command_validate)

    databases = sub.add_parser("databases", help="database manifest utilities")
    database_sub = databases.add_subparsers(dest="database_command", required=True)
    check = database_sub.add_parser("check", help="verify database paths and checksums")
    check.add_argument("--manifest", type=Path, required=True)
    check.add_argument("--destination", type=Path)
    check.add_argument("--report", type=Path)
    check.set_defaults(func=command_database_check)

    install = database_sub.add_parser("install", help="run the checkpointed TRIARCHY database installer")
    install.add_argument("--manifest", type=Path, help="optional manifest to verify after installation")
    install.add_argument("--destination", type=Path, required=True)
    install.add_argument("--silva-archive", type=Path)
    install.add_argument("--kraken-archive", type=Path)
    install.add_argument("--download-attempts", type=int)
    install.add_argument("--yes", action="store_true")
    install.add_argument("--report", type=Path)
    install.set_defaults(func=command_database_install)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
