includeConfig 'conf/primers.config'

manifest {
    name = 'TRIARCHY'
    author = 'TRIARCHY contributors'
    description = 'Control-aware integration of WMS, 16S, and ITS microbiome assays'
    mainScript = 'main.nf'
    version = '1.0.0'
    homePage = 'https://github.com/aglucaci/TRIARCHY'
    license = 'GPL-3.0-only'
    nextflowVersion = '>=26.04.0'
}

params {
    input = null
    samples = null
    paired_controls = null
    controls = null
    outdir = 'results'
    reference_root = ''

    host_index = ''
    kraken2_db = ''
    kraken2_memory_mapping = true
    bracken_read_length = 150
    humann_db = ''
    humann_protein_db = ''
    metaphlan_db = ''
    metaphlan_index = ''
    humann_time = '48h'
    s16_taxonomy = ''
    its_taxonomy = ''
    taxonomy_crosswalk = ''
    assay_performance = "${projectDir}/conf/assay_performance.tsv"
    evidence_policy = "${projectDir}/conf/evidence_policy.json"

    fastp_extra = ''
}

process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxRetries = 1

    withLabel: low {
        cpus = 1
        memory = 2.GB
        time = 1.h
    }
    withLabel: medium {
        cpus = 2
        memory = 4.GB
        time = 4.h
    }
    withLabel: high {
        cpus = 4
        memory = 12.GB
        time = 12.h
    }
    withName: WGS_FUNCTIONS {
        time = params.humann_time
    }
}

profiles {
    local {
        process.executor = 'local'
    }
    laptop {
        process.executor = 'local'
        executor.queueSize = 2
        process {
            withLabel: medium {
                cpus = 2
                memory = 4.GB
            }
            withLabel: high {
                cpus = 2
                memory = 8.GB
            }
        }
    }
    workstation {
        process.executor = 'local'
        executor.queueSize = 6
        process {
            withLabel: high {
                cpus = 8
                memory = 32.GB
            }
        }
    }
    high_memory {
        process {
            withLabel: high {
                cpus = 8
                memory = 64.GB
                time = 24.h
            }
        }
    }
    docker {
        includeConfig 'conf/docker.config'
    }
    apptainer {
        includeConfig 'conf/apptainer.config'
    }
    singularity {
        includeConfig 'conf/singularity.config'
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
    cloud {
        process.executor = 'local'
    }
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.tsv"
    overwrite = true
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag.html"
    overwrite = true
}
