manifest {
    name = 'TRIARCHY'
    author = 'TRIARCHY contributors'
    description = 'Control-aware integration of WMS, 16S, and ITS microbiome assays'
    mainScript = 'main.nf'
    nextflowVersion = '>=26.04.0'
}

params {
    samples = null
    controls = null
    outdir = 'results'

    host_index = ''
    kraken2_db = ''
    bracken_read_length = 150
    humann_db = ''
    humann_protein_db = ''
    s16_taxonomy = ''
    its_taxonomy = ''
    taxonomy_crosswalk = ''
    assay_performance = "${projectDir}/conf/assay_performance.tsv"
    evidence_policy = "${projectDir}/conf/evidence_policy.json"

    fastp_extra = ''
    cutadapt_16s_forward = ''
    cutadapt_16s_reverse = ''
    cutadapt_its_forward = ''
    cutadapt_its_reverse = ''
}

process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxRetries = 1

    withLabel: low {
        cpus = 1
        memory = 2.GB
        time = 1.h
    }
    withLabel: medium {
        cpus = 2
        memory = 4.GB
        time = 4.h
    }
    withLabel: high {
        cpus = 4
        memory = 12.GB
        time = 12.h
    }
}

profiles {
    local {
        process.executor = 'local'
    }
    docker {
        docker.enabled = true
        process.executor = 'local'
    }
    singularity {
        singularity.enabled = true
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
    }
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.tsv"
    overwrite = true
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag.html"
    overwrite = true
}
